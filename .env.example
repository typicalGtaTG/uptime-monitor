# Copy this file to .env and replace values for your environment.

JWT_SECRET=your-strong-random-jwt-secret
GLOBALPING_API_KEY=
PORT=3000

# Failover / local monitoring controls
ENABLE_LOCAL_FALLBACK=true
FORCE_LOCAL_ONLY_MODE=false
GLOBALPING_FAILOVER_THRESHOLD=3
GLOBALPING_RECOVERY_SUCCESS_THRESHOLD=2
GLOBALPING_RECOVERY_PROBE_INTERVAL_MS=120000
